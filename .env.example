# ---------------------------------------------------------------------------
# Remi - environment variables. Copy to .env and fill in. NEVER commit .env.
# Every provider below has a FREE tier that needs no credit card.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
APP_ENV=development              # production → secure cookies
PORT=8000
SECRET_KEY=                      # signs workspace cookies + token HMACs; empty = dev default locally, random per process in production
DATA_DIR=./data                  # SQLite file lives here (ephemeral on free hosts - re-seeds on restart)
# DATABASE_URL=sqlite:///./data/remi.db

# --- Sandbox / demo behaviour ------------------------------------------------
DEMO_MODE=true                   # demo: transfers settle after DEMO_SETTLE_SECONDS
DEMO_SETTLE_SECONDS=12
COOLING_OFF_SECONDS=60           # new-payee cooling-off (short for demos; production would be hours)
CONFIRMATION_TTL_SECONDS=300     # confirmation token lifetime (5 min)
WORKSPACE_IDLE_HOURS=24          # idle visitor workspaces are deleted after this
# SANDBOX_FIXED_NOW=2026-10-14T10:00:00Z   # pin the clock (tests/evals)

# --- LLM providers (OpenAI-compatible chat completions + tool calling) -------
# Primary provider and fallback chain. On 429/timeout/tool error: retry once, then next provider.
LLM_PROVIDER=gemini
LLM_FALLBACK=gemini,groq,openrouter,ollama,mock
LLM_CACHE=replay                 # record | replay | off  (replay serves evals/replay_cache.json first)
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_SECONDS=0.8             # wait before the single retry (evals use 20 s for free-tier 429s)
LLM_DAILY_BUDGET=400             # app-wide live LLM calls per day; then replay/mock "demo mode"

# Google Gemini (free key, no card): https://aistudio.google.com/apikey
# OpenAI-compatible base URL: https://generativelanguage.googleapis.com/v1beta/openai/
# Model IDs checked 2026-10-16 at https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite     # or gemini-3.8-flash (smarter, lower free quota)

# Groq (free key, no card): https://console.groq.com/keys  · base URL https://api.groq.com/openai/v1
# All Groq-hosted models support tool use (https://console.groq.com/docs/tool-use)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (free ":free" models, no card): https://openrouter.ai/keys · base URL https://openrouter.ai/api/v1
# Pick a current free model with tool support at https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Ollama (local, offline, unlimited): https://ollama.com · `ollama pull qwen3:4b`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b

# --- Knowledge base (RAG) ----------------------------------------------------
KB_USE_EMBEDDINGS=true           # local fastembed BGE-small (downloads ~130 MB once); false = BM25 only
KB_ALPHA=0.6                     # hybrid weight: α·cosine + (1−α)·BM25
KB_MIN_SCORE=0.35                # below this the agent says it doesn't know

# --- Public deployment protection --------------------------------------------
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Deployment (only for ./scripts/deploy_hf.sh) ------------------------------
# Hugging Face write token: https://huggingface.co/settings/tokens
# HF_TOKEN=
# HF_SPACE=<your-hf-user>/remi
