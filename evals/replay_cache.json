 "18c79126416f68a03ab094c2a95b61d424820b9810b4a95d59ffaf9e97079981": {
  "content": "When paying tuition from abroad, banks and payment platforms commonly request the following documents [KB: Tuition payment documentation checklist]:\n\n- An offer letter, admission letter, or enrolment confirmation [KB: Tuition payment documentation checklist].\n- The official tuition invoice showing your student ID, amount due, and payment details [KB: Tuition payment documentation checklist].\n- A copy of your passport and student visa/study permit [KB: Tuition payment documentation checklist].\n- A source-of-funds declaration, such as family bank statements, an education loan sanction letter, or a scholarship letter [KB: Tuition payment documentation checklist].\n- An education purpose-of-payment code for the remittance [KB: Purpose-of-purpose codes and source of funds].\n\nRequirements vary by corridor and institution, so it is best to check with your sending bank and university finance office early [KB: Tuition payment documentation checklist].",
  "model": "gemini-3.5-flash-lite",
  "provider": "gemini",
  "recorded_at": "2026-10-16T18:18:36Z",
  "tool_calls": []
 },
