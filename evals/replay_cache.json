 "18c79126416f68a03ab094c2a95b61d424820b9810b4a95d59ffaf9e97079981": {
  "content": "When paying tuition from abroad, banks and payment platforms commonly ask for [KB: Tuition payment documentation checklist]:\n\n- An offer letter, admission letter, or enrolment confirmation.\n- The official tuition invoice showing your student ID, amount due, and the institution's payment details.\n- A copy of your passport and student visa/permit.\n- A source-of-funds declaration (such as family support letters, scholarship documentation, or an education loan sanction letter) [KB: Purpose-of-purpose-codes-source-of-funds].\n- An education purpose-of-payment code required by sending-country regulations [KB: Purpose-of-payment codes and source of funds].\n\nRequirements vary by corridor and institution, so always check with your sending bank and university finance office in advance [KB: Tuition payment documentation checklist].",
  "model": "gemini-3.5-flash-lite",
  "provider": "gemini",
  "recorded_at": "2026-10-16T17:45:57Z",
  "tool_calls": []
 },
